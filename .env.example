# Modo de datos:
# - local: todo queda en el navegador (demostración y desarrollo sin cuenta).
# - supabase: inicio de sesión y datos compartidos en Supabase.
NEXT_PUBLIC_DATA_MODE=local

# Solo para el modo supabase. La clave publicable es pública por diseño: los
# permisos los aplica RLS. Nunca pongas aquí la clave service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
